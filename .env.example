# VivaahFlow environment example.
# Copy to .env ONLY if your deployment reads env vars;
# the default install uses config/config.php (which already honors these vars).
# Never commit a real .env with passwords.

APP_NAME=VivaahFlow
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/VivaahFlow

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vivaahflow
DB_USER=root
DB_PASS=

APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
APP_CURRENCY_SYMBOL=₹

SESSION_NAME=vivaahflow_sess
SESSION_SECURE=false
