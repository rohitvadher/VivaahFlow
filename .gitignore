# =========================================================
# VivaahFlow - Git Ignore
# =========================================================

# Environment / secrets
.env
.env.*
!.env.example

# Local configuration overrides
config/local.php
config/*.local.php

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# Logs
*.log
logs/
storage/logs/
storage/*.log

# Temporary files
tmp/
temp/
cache/
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# Runtime/generated files
storage/cache/
storage/sessions/
storage/framework/
storage/runtime/

# Uploads generated by users (keep required demo assets via negations below)
uploads/customers/*
uploads/temp/*
uploads/*.log
!uploads/customers/.gitkeep
!uploads/temp/.gitkeep

# User-generated customer files
storage/uploads/
storage/user-content/

# Generated exports/reports
storage/exports/
storage/reports/
exports/
reports/

# Database dumps generated locally
*.dump
*.sql.gz
*.sqlite
*.sqlite3

# Local development databases
*.db

# Coverage / test output
coverage/
.phpunit.result.cache

# Composer
/vendor/

# Node
/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build output
dist/
build/
*.map

# PHPStan / static analysis cache
.phpstan.cache

# PHPUnit
.phpunit.cache/

# Local server files
.ngrok/
